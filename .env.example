# DeepSeek API Key (cloud AI)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Access Token for API authentication
# Generate a random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This token is shared between frontend and backend via Nuxt runtimeConfig.public
ACCESS_TOKEN=your-random-access-token-here

# GitHub username shown on the homepage GitHub stats card
GITHUB_USERNAME=ynl4

# Optional overrides for the local Qwen model download (WebLLM).
# Defaults already work from mainland China:
# - the wasm runtime is served from public/web-llm/ (same-origin);
# - model weights are proxied through this app's Nitro server
#   (/api/llm-model/...) which fetches from hf-mirror.com server-side.
# LOCAL_LLM_UPSTREAM_URL: upstream host for the model file proxy
#   (default https://hf-mirror.com, e.g. set to https://huggingface.co).
# LOCAL_LLM_MODEL_URL / LOCAL_LLM_MODEL_LIB_URL: advanced direct overrides;
#   direct URLs must be reachable AND CORS-enabled from the browser.
# Requires `pnpm dev`/`pnpm build` restart.
# LOCAL_LLM_UPSTREAM_URL=https://huggingface.co
# LOCAL_LLM_MODEL_URL=https://huggingface.co/mlc-ai/Phi-3-mini-4k-instruct-q4f16_1-MLC
# LOCAL_LLM_MODEL_LIB_URL=https://raw.githubusercontent.com/mlc-ai/binary-mlc-llm-libs/main/web-llm-models/v0_2_84/base/Phi-3-mini-4k-instruct-q4f16_1_cs1k-webgpu.wasm
